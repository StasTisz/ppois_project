# ==============================================================================
# Telegram Bot Configuration Template (.env.example)
# Скопируйте этот файл в .env и укажите ваш токен:
# cp .env.example .env
# ==============================================================================

# Токен Telegram-бота от @BotFather (ОБЯЗАТЕЛЬНО)
BOT_TOKEN=your_telegram_bot_token_here

# Путь к базе данных SQLite
DB_PATH=data/movies.db

# Путь к исходному каталогу фильмов
SEED_JSON_PATH=data/initial_movies.json

# (Опционально) ID группы/канала
CACHE_CHANNEL_ID=-1001234567890

# Количество рабочих потоков
BOT_THREAD_POOL_SIZE=4
